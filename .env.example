# Copy to .env and adjust:  cp .env.example .env
# ⚠️ Change every password before using this anywhere but local dev.

# ── Database selection ───────────────────────────────────────────────────────
# Picks which bundled database (if any) `docker compose up` starts. The fxserver
# always runs and has no hard dependency on the DB, so you can also leave this
# EMPTY and point the *_HOST values below at an existing/external database.
#   postgres   → start the bundled PostgreSQL service (default)
#   mariadb    → start the bundled MariaDB service (what most FiveM resources use)
#   <empty>    → start no bundled DB; use your own external DB
COMPOSE_PROFILES="postgres"

# ── FiveM server build ───────────────────────────────────────────────────────
# Build id of the FiveM Linux artifacts the fxserver image is built from.
# Default = the current Cfx.re "recommended" build. Look up recommended/latest:
#   https://changelogs-live.fivem.net/api/changelog/versions/linux/server
#   (folder list: https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/)
FXSERVER_VERSION="25770-8ddccd4e4dfd6a760ce18651656463f961cc4761"

# Base image for the fxserver build. The FiveM artifacts bundle their own libc,
# so the host distro is non-critical. debian:trixie-slim (Debian 13) is also fine.
BASE_IMAGE="debian:bookworm-slim"

# ── PostgreSQL  (used when COMPOSE_PROFILES=postgres) ─────────────────────────
# Pin e.g. 18.4-alpine3.23 instead of 18-alpine for fully reproducible builds.
POSTGRES_VERSION="18-alpine"
POSTGRES_USER="fivem"
POSTGRES_PASSWORD="change_me_dev_password"
POSTGRES_DB="fivem"
POSTGRES_PORT="5432"
# Host the fxserver CONTAINER connects to. Keep "postgres" (the service name) for
# the bundled DB; set to a hostname/IP to use your own external Postgres.
POSTGRES_HOST="postgres"

# ── MariaDB / MySQL  (used when COMPOSE_PROFILES=mariadb) ─────────────────────
# 11.8 = current LTS (supported to 2028-06). Newest LTS line: 12.3.
MARIADB_VERSION="11.8"
MYSQL_USER="fivem"
MYSQL_PASSWORD="change_me_dev_password"
MYSQL_ROOT_PASSWORD="change_me_dev_root_password"
MYSQL_DB="fivem"
MYSQL_PORT="3306"
# Host the fxserver CONTAINER connects to. Keep "mariadb" (the service name) for
# the bundled DB; set to a hostname/IP to use your own external MySQL/MariaDB.
MYSQL_HOST="mariadb"

# ── Ports ────────────────────────────────────────────────────────────────────
# Host port for the txAdmin web panel (container port is fixed at 40120).
TXADMIN_PORT="40120"
# Host port for the FiveM game server (TCP+UDP, container port fixed at 30120).
GAME_PORT="30120"

# ── Game server ──────────────────────────────────────────────────────────────
# Optional connect password (leave empty for an open server).
SERVER_PASSWORD=""

# ── Host-side connection string (optional convenience) ───────────────────────
# For psql / GUI tools running on YOUR machine (host = localhost). Inside Docker
# the fxserver builds its own DATABASE_URL / MYSQL_CONNECTION_STRING from the
# *_HOST values above — this line is NOT read by Compose.
DATABASE_URL="postgresql://fivem:change_me_dev_password@localhost:5432/fivem"
